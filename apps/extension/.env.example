# The Integrations Assistant extension's build-time configuration.
#
# Only PLASMO_PUBLIC_* names are inlined into the extension's code — anything else here is
# invisible at runtime. Copy this to `.env.development` for local work; CI supplies the same
# names from the CircleCI STAGING / PRODUCTION contexts.

# MediaJel's assistant service. Locally that is apps/assistant-api (`bun run dev` there), whose
# routes sit under the global `api` prefix and the feature controller — the same shape the
# destination service in amplication-nestjs-microservices uses, so this URL survives the move.
# No trailing slash.
PLASMO_PUBLIC_WIDGET_API_URL=http://localhost:3011/api/assistant

# The Cognito user pool the extension signs into: the same one the MediaJel dashboard uses.
# These are public identifiers, not secrets — the app client has no secret, which is what lets
# a browser authenticate against it directly.
PLASMO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_vilv2LvwU
PLASMO_PUBLIC_COGNITO_CLIENT_ID=6g7p5mp970gbs3dsfujmg6q2c5
PLASMO_PUBLIC_COGNITO_REGION=us-east-1

# Where a deployed tag is served from, so the receipt can name the URL it will appear at.
PLASMO_PUBLIC_FRICTIONLESS_CUSTOMTAG_URL=

# The tag "load the tag on this page" injects, for sites that have not installed it yet.
PLASMO_PUBLIC_TAG_URL=https://tags.cnna.io/index.js
PLASMO_PUBLIC_TAG_ORIGIN=https://tags.cnna.io

# A fixed key pins the extension id across reinstalls, so a rebuild does not orphan saved jobs.
# Generate one with:  openssl genrsa 2048 | openssl rsa -pubout -outform DER | base64 -w0
CRX_PUBLIC_KEY=
