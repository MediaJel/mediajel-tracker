{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Parcel inlines these into the tag bundle. Declare them so turbo's strict mode (default)
  // doesn't drop them in CI. globalEnv (not passThroughEnv) also busts the cache when they change.
  "globalEnv": [
    "COLLECTOR_URL",
    "MJ_PRODUCTION_COLLECTOR_URL",
    "MJ_STAGING_COLLECTOR_URL",
    "FRICTIONLESS_CUSTOMTAG_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Pure unit tests: no browser, no build, no pipeline. Separate from `test` (which is
    // apps/tracker's Cypress suite and needs servers) so CI can run these on their own.
    "test:unit": {},
    // The browser suite needs the tag actually built, and built against the collector the rig
    // serves — which is why COLLECTOR_URL is in globalEnv above. Never cached: it asserts against a
    // live Snowplow Micro, so a cache hit would report yesterday's pipeline.
    "e2e": {
      "dependsOn": ["mediajel-tracker#build"],
      "cache": false
    },
    // Runs only in build-main, and uploads the generated environments file to S3. Strict mode
    // (the default) passes a task nothing it has not declared, so without this the four AWS
    // credentials arrive undefined — and the script reports every failure with console.error and
    // no exit code, so the deploy step stays green while uploading nothing. On main this runs
    // outside turbo with the full environment, so the monorepo is what introduces the hazard.
    "generate-environments": {
      "cache": false,
      "env": [
        "AWS_REGION_PROD",
        "AWS_ACCESS_KEY_ID_PROD",
        "AWS_SECRET_ACCESS_KEY_PROD",
        "BUCKET_GENERATE_ENVIRONMENTS_PROD"
      ]
    }
  }
}
