{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Parcel inlines these into the tag bundle. Declare them so turbo's strict mode (default)
  // doesn't drop them in CI. globalEnv (not passThroughEnv) also busts the cache when they change.
  "globalEnv": ["COLLECTOR_URL", "FRICTIONLESS_CUSTOMTAG_URL", "WIDGET_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "generate-environments": {
      "cache": false
    }
  }
}
